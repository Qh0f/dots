@import "~/.cache/wal/colors-rofi.rasi"

* {
    font:                "JetBrainsMono NFP 14";
    background-color:    transparent;
    text-color:          @co6;
    border-color:        @co4;
}

window {
    background-color:    @co1;
    border:              1px;
    border-color:        @co4;
    border-radius:       14px;
    width:               560px;
    padding:             12px;
    location:            center;
}

mainbox {
    background-color:    transparent;
    children:            [ mode-switcher, inputbar, listview ];
    spacing:             10px;
}

mode-switcher {
    background-color:    transparent;
    spacing:             6px;
}

button {
    background-color:    @co2;
    text-color:           @co8;
    border-radius:        8px;
    padding:              8px 12px;
    horizontal-align:     0.5;
    cursor:               pointer;
    border:               1px;
    border-color:         transparent;
}

button selected {
    background-color:    @co3;
    text-color:           @co4;
    border:               1px;
    border-color:         @co4;
}

inputbar {
    background-color:    @co2;
    border-radius:       10px;
    padding:             10px 14px;
    spacing:             10px;
    children:            [ prompt, entry ];
}

prompt {
    background-color:    transparent;
    text-color:          @co4;
    font:                "JetBrainsMono NFP Bold 14";
}

entry {
    background-color:    transparent;
    text-color:          @co6;
    placeholder:         "Search...";
    placeholder-color:   @co8;
    cursor:              text;
}

listview {
    background-color:    transparent;
    columns:             1;
    lines:               8;
    scrollbar:           false;
    spacing:             4px;
    fixed-height:        true;
}

element {
    background-color:    transparent;
    border-radius:       8px;
    padding:             10px 12px;
    spacing:             12px;
    children:            [ element-icon, element-text ];
    orientation:         horizontal;
    cursor:              pointer;
}

element normal.normal {
    text-color:          @co6;
}

element alternate.normal {
    text-color:          @co7;
}

element selected.normal {
    background-color:    @co3;
    border:              1px;
    border-color:        @co4;
    text-color:          @co4;
}

element normal.urgent,
element selected.urgent {
    background-color:    @co5;
}

element-icon {
    background-color:    transparent;
    size:                32px;
    cursor:              inherit;
}

element-text {
    background-color:    transparent;
    text-color:          inherit;
    highlight:           bold #e4e7ec;
    cursor:              inherit;
    vertical-align:      0.5;
}
